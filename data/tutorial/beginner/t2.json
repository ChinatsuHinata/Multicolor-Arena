  "steps": {
    "d1": {
      "type": "info",
      "camera_view": "enemy_palette",
      "guide": {
        "text": "现在开始一次开局。电脑赢得骰子后选择了后手；后手玩家得到一张秋瓤子的红薯，可当作任意一费使用。",
        "targets": [
          {
            "player": 1
          }
        ],
        "next_button": "manual"
      },
      "next": "d2"
    },
    "d2": {
      "type": "info",
      "camera_view": "battlefield",
      "guide": {
        "text": "起始时双方各抽四张牌。可以把不需要的起手牌洗入牌库底，再补抽相同数量。观察这四张牌，先找出颜色值较高的两张。",
        "next_button": "manual"
      },
      "next": "r1"
    },
    "r1": {
      "type": "task",
      "guide": {
        "layout": "side",
        "popup": "show",
        "next_button": "hidden",
        "text": "请在手牌中选择两张高费卡牌调度下去，通过右键或长按可以详细观看卡牌效果。"
      },
      "task": {
        "timing": "mulligan_selection",
        "required_aliases": [
          "night_king",
          "fire_person"
        ]
      },
      "next": "d3"
    },
    "d3": {
      "type": "info",
      "guide": {
        "text": "调度完成，你是先手。准备阶段会重置战场与颜色盘中的牌，并从牌库顶放一张牌进颜色盘；一些能力也会在此时触发。",
        "next_button": "manual"
      },
      "next": "d4"
    },
    "d4": {
      "type": "info",
      "guide": {
        "text": "接着是抓牌阶段。先手玩家的第一回合不抓牌；每个阶段开始后，双方仍有响应的机会。",
        "next_button": "manual"
      },
      "next": "d6"
    },
    "d6": {
      "type": "info",
      "camera_view": "own_palette",
      "guide": {
        "text": "凭依阶段可以交换手牌与颜色盘中的一张未横置牌。每张牌通常只能支付一费；本回合先不凭依。",
        "targets": [
          {
            "alias": "black_resource"
          }
        ],
        "next_button": "manual"
      },
      "next": "d7"
    },
    "d7": {
      "type": "info",
      "camera_view": "battlefield",
      "guide": {
        "text": "进入主要阶段。颜色盘里有一张可支付黑费的牌，正好能使用手中的一黑费单位莉莉黑。使用前可右键或长按查看卡牌详情。",
        "targets": [
          {
            "alias": "lily_black"
          }
        ],
        "next_button": "manual"
      },
      "next": "r2",
      "scenario": "first_main"
    },
    "r2": {
      "type": "task",
      "guide": {
        "text": "使用莉莉黑，并在入场颜色选择中选红色。等待她实际进入战场。",
        "popup": "show",
        "next_button": "hidden",
        "targets": [
          {
            "alias": "lily_black"
          }
