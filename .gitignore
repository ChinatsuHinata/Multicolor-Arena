# Godot caches and machine-local export toolchain (keep .uid and .import sources).
.godot/
/android/
/.godot-toolchain/
/builds/
/installer/
/MulticolorArena-Installer-Tool/
/tools/installer-toolkit/

# Test code, documentation and intentional fixtures are retained.
/tests/*
!/tests/*.gd
!/tests/*.gd.uid
!/tests/*.py
!/tests/*.md
!/tests/support/
!/tests/support/**

# Player data and local experiments; keep import guards for generated resources.
/deck/
/replay/
/training/
/saves/*
!/saves/.gdignore
/work/*
!/work/.gdignore
/models/
/experiments/
/mods.json
/mod/

# Generated packages, reports, attachments and previous Unity distributions.
/output/
/outputs/
/tmp/
/.codex-remote-attachments/
/recourse/MulticolourOnline/
/recourse/MulticolourOnline2.0/
*.exe
*.msi
*.apk
*.aab
*.pck
*-setup.exe
*.log
*.bak
*.bak.*
*.tmp
*.temp
*.swp
*.swo
~$*
.DS_Store
Thumbs.db
Desktop.ini

# Python caches and local virtual environments.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Shared editor tasks are source; editor/session preferences stay local.
.vscode/*
!.vscode/tasks.json
.idea/
*.code-workspace

# Machine-specific packaging/upload helpers.
/tools/build-installer.ps1
/tools/auto-commit-push.ps1

# Deployment secrets and player databases (data/*_public.pem are required).
/relay/account_private.pem
/relay/update_private.pem
/relay/data/
/relay/.ssh-deploy-key
*.keystore
*.jks
*.p12
*.pfx
.env
.env.*
!.env.example
!.env.sample
