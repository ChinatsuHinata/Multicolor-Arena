extends "res://tests/support/network_base.gd"
const Remote=preload("res://net/remote_duel.gd")
const Observer=preload("res://net/observer_projection.gd")
var spectator
func run():
 var directory="res://work/leader-emotes-network/"+str(Time.get_ticks_usec())
 Store.Paths.root_override=ProjectSettings.globalize_path(directory)
 host=Session.new();guest=Session.new();root.add_child(host);root.add_child(guest)
 host.initialize(directory+"/host");guest.initialize(directory+"/guest")
 check(host.create_room(3,false,48106,"127.0.0.1","test").is_empty(),"create leader-emote loopback room")
 check(guest.join_room("127.0.0.1",48106).is_empty(),"guest connects to emote loopback room")
 var joined=await until(func():return not host.applicant.is_empty())
 check(joined,"emote guest requests entry: "+host.notice+" / "+guest.notice)
 if not joined:host.leave(false);guest.leave(false);quit(1);return
 host.accept_applicant(true)
 check(await until(func():return host.can_act() and guest.can_act()),"emote clients synchronize")
 var a=Store.blank("自机表情联机测试");a.leader="70";a.main=["100","100","100","100","100","100"];a.rule_set="test"
 host.room_action({"name":"deck","deck":a})
 check(await until(func():return host.can_act() and guest.can_act()),"host emote deck registered")
 guest.room_action({"name":"deck","deck":a})
 check(await until(func():return host.series.state.decks[1].get("leader","")=="70" and host.can_act() and guest.can_act()),"guest emote deck registered")
 await prepare()
 spectator=Session.new();root.add_child(spectator);spectator.initialize(directory+"/spectator")
 check(spectator.join_spectator("127.0.0.1",48106).is_empty(),"third-party spectator connects to emote room")
 check(await until(func():return spectator.connected and spectator.sequence==host.sequence),"spectator receives public battle snapshot")
 check(not spectator.submit({"name":"send_emote","args":["greeting"]}).is_empty(),"spectator cannot send battle emotes")
 while not spectator.snapshots.is_empty():spectator.pop_snapshot()
 var e=host.authority;e.phase="main";e.pending={};e.entry_choices=[];e.active=1;e.priority=1;e.presentation_events.clear()
 e.leader_emote_profiles[1].enabled=true
 host.sequence+=1;host.publish([])
 check(await until(func():return guest.sequence==host.sequence and guest.can_act()),"test-only enabled leader synchronized")
 sync_views()
 var before_undo=host.undo_history.entries.size()
 check(guest.submit({"name":"send_emote","args":["surprise"]}).is_empty(),"guest sends emote through socket command")
 var packet=guest.inflight.duplicate(true)
 check(await until(func():return e.emote_serial==1 and guest.sequence==host.sequence and guest.can_act()),"authority accepts emote and acknowledges both players")
 var event=guest.latest_snapshot.projection.state.presentation_events[0]
 check(event.type=="result" and event.get("emote",false) and event.kind=="surprise" and event.owner==1,"peer receives authoritative legacy-safe dialogue event")
 check(host.latest_snapshot.projection.state.presentation_events==[event],"sender and opponent receive the same dialogue exactly once")
 check(host.undo_history.entries.size()==before_undo,"emote adds no gameplay undo checkpoint")
 var remote=Remote.new();remote.apply_snapshot(guest.latest_snapshot.projection)
 var remaining=remote.emote_remaining(1)
 check(remaining>0.0 and remaining<=10.0 and absf(remaining-e.emote_remaining(1))<1.0,"remote cooldown agrees with authority after serialization and transport")
 var observed=Observer.build(e,[event])
 check(observed.state.presentation_events==[event],"spectator sees identical public emote event")
 check(await until(func():return spectator.sequence==host.sequence),"guest emote reaches third-party spectator through socket")
 check(spectator.latest_snapshot.projection.state.presentation_events==[event],"third-party spectator receives guest's authoritative dialogue")
 while not spectator.snapshots.is_empty():spectator.pop_snapshot()
 sync_views();var sequence=host.sequence
 host.handle_command(1,packet)
 check(await until(func():return guest.can_act()),"duplicate emote receipt acknowledged")
 check(e.emote_serial==1 and host.sequence==sequence,"retransmitted command cannot send twice")
 sync_views();var errors=[];guest.error_raised.connect(func(message):errors.append(message))
 guest.submit({"name":"send_emote","args":["praise"]})
 check(await until(func():return not errors.is_empty() and guest.can_act()),"authority rejects second emote during cooldown")
 check(e.emote_serial==1 and host.sequence==sequence,"rejected emote preserves authoritative state")
 sync_views()
 var saved=host.Journal.load_from(host.storage+"/host.bin");var restored=Session.Duel.new();host.Codec.restore(restored,saved.engine)
 check(restored.emote_serial==1 and restored.emote_ready_at==e.emote_ready_at,"persistent room recovery retains cooldown")
 e.leader_emote_profiles[0].enabled=true;e.priority=0
 host.sequence+=1;host.publish([])
 check(await until(func():return host.can_act() and guest.can_act() and guest.sequence==host.sequence and spectator.sequence==host.sequence),"host response priority synchronizes with both clients")
 sync_views()
 check(host.submit({"name":"send_emote","args":["greeting"]}).is_empty(),"host sends own battle emote")
 check(await until(func():return e.emote_serial==2 and guest.sequence==host.sequence and spectator.sequence==host.sequence and guest.can_act()),"host emote synchronizes with opponent and spectator")
 var host_events=spectator.latest_snapshot.projection.state.presentation_events
 check(host_events.size()==1 and host_events[0].owner==0 and host_events[0].kind=="greeting","third-party spectator receives host's authoritative dialogue")
 while not spectator.snapshots.is_empty():spectator.pop_snapshot()
 sync_views()
 e.leader_emote_profiles[1].enabled=false
 guest.submit({"name":"surrender","args":[]})
 check(await until(func():return e.winner==0 and guest.sequence==host.sequence and guest.can_act()),"disabled guest can surrender during cooldown")
 var surrender_events=host.latest_snapshot.projection.state.presentation_events.filter(func(item):return item.get("emote",false))
 check(surrender_events.size()==1 and surrender_events[0].kind=="surrender" and surrender_events[0].owner==1,"opponent receives disabled leader's single surrender bubble")
 check(await until(func():return spectator.sequence==host.sequence),"surrender dialogue reaches third-party spectator")
 check(spectator.latest_snapshot.projection.state.presentation_events==surrender_events,"spectator receives disabled leader's surrender dialogue")
 spectator.leave(false);spectator.queue_free()
 guest.leave(false);host.leave(false);host.queue_free();guest.queue_free();await process_frame
 print("LEADER_EMOTES_NETWORK: ",checks," checks; failures=",failures)
 quit(0 if failures.is_empty() else 1)
