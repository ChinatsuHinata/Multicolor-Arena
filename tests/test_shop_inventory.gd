extends SceneTree
const Inventory=preload("res://scripts/shop_inventory.gd")
var failures=0
var checks=0
func expect(ok: bool,message: String):
 checks+=1
 if not ok:failures+=1;push_error(message)
func _initialize():call_deferred("run")
func run():
 var folder="res://work/shop-inventory/"+str(Time.get_ticks_usec())
 DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(folder))
 var path=folder.path_join("loadout.json")
 var inv=Inventory.new();inv.initialize(path,true)
 var start=int(inv.sale.starts_at);var end=int(inv.sale.ends_at)
 expect(Time.get_unix_time_from_datetime_string("2026-11-01T16:00:00Z")==end,"sale ends at November 2 midnight in UTC+8")
 expect(not inv.sale_active(start-1) and inv.sale_active(start) and inv.sale_active(end-1) and not inv.sale_active(end),"sale has inclusive start and exclusive end")
 for item in inv.catalogue:
  if item.price>0:
   expect(inv.is_special(item,start) and inv.price_for(item,start)==Inventory.discounted_price(item.price) and inv.price_for(item,end)==item.price,"paid products are half price only during the sale: "+item.id)
  else:
   expect(not inv.is_special(item,start) and inv.price_for(item,start)==0 and inv.price_for(item,end)==0,"free effects stay free without sale badges: "+item.id)
 expect(Inventory.discounted_price(11)==6 and Inventory.discounted_price(1)==1 and Inventory.discounted_price(0)==0,"half-price copper always rounds up")
 expect(not inv.catalogue.is_empty() and inv.product("test_leader_emotes").is_empty(),"test product is delisted even in test builds")
 inv.sync_session("ACCOUNT_A",{})
 inv.sync_session("ACCOUNT_A",{"server_time":start})
 expect(absf(inv.current_time()-start)<2,"sale uses the server clock with monotonic elapsed time")
 expect(not inv.claim_test("test_leader_emotes"),"delisted test pack cannot be claimed")
 expect(not inv.set_battle_enabled("emotes_reimu",true),"unowned products cannot be equipped")
 inv.sync_session("ACCOUNT_A",{"purchased_product_ids":["emotes_reimu"],"shop_grants":{"emotes_reimu":"fixture"}})
 expect(inv.owns("emotes_reimu") and inv.battle_enabled("emotes_reimu"),"new purchase starts enabled")
 expect(inv.set_battle_enabled("emotes_reimu",true),"owned product can be equipped")
 var frozen=inv.battle_loadout()
 expect(frozen.has("emotes_reimu") and inv.network_loadout()=={"emotes_reimu":"fixture"},"equipped product is included in local and anonymous network loadouts")
 inv.set_battle_enabled("emotes_reimu",false)
 expect(inv.battle_loadout().is_empty() and frozen.has("emotes_reimu"),"equipment changes do not mutate active match loadout")
 var disabled=Inventory.new();disabled.initialize(path)
 disabled.sync_session("account_a",{"purchased_product_ids":["emotes_reimu"]})
 expect(not disabled.battle_enabled("emotes_reimu"),"explicitly disabled product stays off after restart and ownership sync")
 disabled.sync_session("account_b",{"purchased_product_ids":["emotes_reimu"]})
 expect(disabled.battle_enabled("emotes_reimu"),"another account defaults to enabled without inheriting the first account's opt-out")
 disabled.sync_session("account_a",{"purchased_product_ids":["emotes_reimu"]})
 expect(not disabled.battle_enabled("emotes_reimu"),"switching accounts preserves each account's saved opt-out")
 inv.set_battle_enabled("emotes_reimu",true)
 var restored=Inventory.new();restored.initialize(path)
 restored.sync_session("account_a",{"purchased_product_ids":["emotes_reimu"]})
 expect(restored.battle_enabled("emotes_reimu"),"equipment survives restart with server ownership")
 restored.sync_session("account_b",{"purchased_product_ids":["emotes_reimu"]})
 expect(restored.battle_enabled("emotes_reimu"),"owned product defaults to enabled for another account without preferences")
 restored.sync_session("account_a",{})
 expect(restored.battle_loadout().is_empty(),"local preferences alone never grant ownership")
 restored.sync_session("",{})
 expect(restored.purchased_ids.is_empty() and restored.network_loadout().is_empty(),"logout clears ownership and grants")
 print("SHOP INVENTORY: ",checks," checks; ",failures," failures")
 quit(0 if failures==0 else 1)
