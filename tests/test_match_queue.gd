extends SceneTree
const Queue=preload("res://relay/match_queue.gd")
var failures=[]
func rank(tier: int=0,level: int=2,stars: int=0,position: int=0) -> Dictionary:
 return {"tier":tier,"level":level,"stars":stars,"position":position}
func _initialize():
 var queue=Queue.new()
 var ranks=[rank(0,2),rank(0,1),rank(1,3),rank(1,2),rank(1,1),rank(2,3),rank(2,2),rank(2,1),rank(3,3),rank(3,2),rank(3,1),rank(4,0)]
 for step in range(ranks.size()):
  check(Queue.rank_step(ranks[step])==step,"rank order maps step %d" % step)
  check(Queue.rank_tier(step)==ranks[step].tier,"rank step %d maps to its major tier" % step)
 check(Queue.rank_step({})==0,"missing rank defaults to the starting rank")
 for first in ranks:
  for second in ranks:
   if first.tier!=second.tier:continue
   queue=Queue.new();queue.add(1,1,first,"same",0);queue.add(2,2,second,"same",0)
   check(queue.take_pairs(0)==[[1,2]],"all levels in major tier %d match immediately: %d / %d" % [first.tier,first.level,second.level])
 queue=Queue.new()
 queue.add(1,1,rank(),"same",0);queue.add(2,2,rank(0,1),"same",0);queue.add(3,3,rank(0,2,2),"same",0)
 check(queue.take_pairs(999)==[[1,3]],"same rank wins over earlier adjacent rank regardless of stars")
 check(queue.entries.has(2),"unpaired player stays queued")
 queue=Queue.new();queue.add(1,1,rank(),"same",0);queue.add(2,2,rank(1,1),"same",19000)
 check(queue.allowed_rank_gap(1,19999)==0 and queue.take_pairs(19999).is_empty(),"different major tiers cannot match before twenty seconds")
 check(queue.allowed_rank_gap(2,20000)==0 and queue.take_pairs(20000)==[[1,2]],"either player expands to every level of the adjacent major tier at exactly twenty seconds")
 queue=Queue.new();queue.add(1,1,rank(2,1),"same",0);queue.add(2,2,rank(1,3),"same",0)
 check(queue.take_pairs(19999).is_empty() and queue.take_pairs(20000)==[[1,2]],"expansion also includes every level of the lower major tier")
 queue=Queue.new();queue.add(1,1,rank(),"same",0);queue.add(2,2,rank(2,1),"same",0)
 check(queue.take_pairs(39999).is_empty() and queue.take_pairs(40000)==[[1,2]],"range continues expanding every twenty seconds")
 for first in ranks:
  for second in ranks:
   if absi(first.tier-second.tier)!=1:continue
   queue=Queue.new();queue.add(1,1,first,"same",0);queue.add(2,2,second,"same",0)
   check(queue.take_pairs(19999).is_empty() and queue.take_pairs(20000)==[[1,2]],"adjacent major tiers include all levels: %d-%d / %d-%d" % [first.tier,first.level,second.tier,second.level])
 queue=Queue.new();queue.add(1,1,rank(),"same",0);queue.add(2,2,rank(0,1),"same",0);queue.add(3,3,rank(),"same",59000)
 check(queue.take_pairs(60000)==[[1,3]],"same rank still takes priority after the range expands")
 queue=Queue.new();queue.add(1,1,rank(1,1),"same",0);queue.add(2,2,rank(2,3),"same",0);queue.add(3,3,rank(1,3),"same",0)
 check(queue.take_pairs(20000)==[[1,3]],"same major tier takes priority over a closer small rank across the tier boundary")
 queue=Queue.new();queue.add(1,1,rank(),"same",0);queue.add(2,2,rank(2,3),"same",0);queue.add(3,3,rank(1,1),"same",0)
 check(queue.take_pairs(40000)==[[2,3]],"nearest major tier is preferred among expanded-range candidates")
 queue=Queue.new();queue.add(1,1,rank(4,0,0,1),"same",0);queue.add(2,2,rank(4,0,0,999),"same",0)
 check(queue.take_pairs(0)==[[1,2]],"Sage leaderboard position does not affect same-rank matching")
 queue=Queue.new();queue.add(1,1,rank(),"same",0);queue.add(2,2,rank(4,0),"same",0)
 check(queue.allowed_rank_gap(1,-20000)==0 and queue.allowed_rank_gap(1,999999999)==4,"range stays within the available major tiers")
 check(queue.take_pairs(79999).is_empty() and queue.take_pairs(80000)==[[1,2]],"maximum major tier distance becomes eligible after eighty seconds")
 queue=Queue.new();queue.add(1,1,rank(),"same",0);queue.add(2,1,rank(),"same",0);queue.add(3,3,rank(),"other",0)
 check(queue.take_pairs(600000).is_empty(),"same account and different versions never pair")
 queue.add(1,1,rank(4,0),"same",9000)
 check(queue.entries[1].since==0 and queue.entries[1].rank_step==0 and not queue.entries[1].has("elo"),"duplicate request cannot reset queue time or rank; queue stores no Elo")
 queue.remove(1);check(not queue.entries.has(1),"cancel removes the queue entry")
 queue=Queue.new();queue.add(1,1,rank(),"same",10);queue.add(2,2,rank(),"same",20);queue.add(3,3,rank(),"same",30);queue.add(4,4,rank(),"same",40)
 check(queue.take_pairs(100)==[[1,2],[3,4]],"equal rank gaps use waiting order and produce disjoint pairs")
 queue=Queue.new();queue.add(1,1,rank(),"same",30);queue.add(2,2,rank(),"same",20);queue.add(3,3,rank(),"same",10)
 check(queue.take_pairs(100)==[[3,2]],"waiting order wins even when insertion order differs")
 queue=Queue.new();queue.add(1,1,rank(),"same",0,"ranked");queue.add(2,2,rank(),"same",0,"casual")
 check(queue.take_pairs(600000).is_empty(),"casual and ranked queues remain separate even after all rank ranges expand")
 queue.add(3,3,rank(4,0),"same",0,"casual")
 check(queue.take_pairs(0)==[[2,3]] and queue.entries.has(1),"casual matches immediately across all ranks while ranked player keeps waiting")
 queue=Queue.new();queue.add(1,1,rank(),"same",0,"casual");queue.add(2,2,rank(),"same",10,"casual");queue.add(3,3,rank(),"other",0,"casual")
 check(queue.take_pairs(10)==[[1,2]] and queue.entries.has(3),"casual matching keeps version isolation and waiting order")
 queue=Queue.new();queue.add(1,1,rank(),"same",0,"ranked");queue.add(2,2,rank(),"same",0,"casual");queue.add(3,3,rank(),"same",0,"exploration")
 check(queue.take_pairs(600000).is_empty(),"entertainment remains isolated from both standard queues")
 queue.add(4,4,rank(4,0),"same",0,"exploration")
 check(queue.take_pairs(0)==[[3,4]] and queue.entries.has(1) and queue.entries.has(2),"entertainment pairs immediately across all ranks")
 queue=Queue.new();queue.add(1,1,rank(),"same",0,"exploration");queue.add(2,2,rank(),"other",0,"exploration")
 check(queue.take_pairs(600000).is_empty(),"entertainment retains client version isolation")
 queue=Queue.new();queue.add(1,1,rank(),"same",0,"exploration");queue.add(2,2,rank(4,0),"same",0,"exploration_random")
 check(queue.take_pairs(600000).is_empty(),"entertainment submodes remain separate regardless of wait time")
 queue.add(3,3,rank(),"same",10,"exploration_random")
 check(queue.take_pairs(10)==[[2,3]] and queue.entries.has(1),"random exploration pairs immediately across all ranks in its own queue")
 queue=Queue.new();queue.add(1,1,rank(),"same",0,"exploration_random");queue.add(2,2,rank(),"other",0,"exploration_random")
 check(queue.take_pairs(600000).is_empty(),"random exploration retains client version isolation")
 quit(0 if failures.is_empty() else 1)
func check(ok: bool,label: String):
 if ok:print("PASS: ",label)
 else:failures.append(label);push_error(label)
