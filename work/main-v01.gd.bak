extends Control
# Replace this with a res:// image path to change the battlefield background.
@export_file("*.png", "*.jpg", "*.webp") var battlefield_background: String = ""
const Store = preload("res://scripts/deck_store.gd")
const GOLD = Color("#d9b775")
const INK = Color("#101c28")
const MUTED = Color("#91a5b7")
const WHITE = Color("#e8edf0")
var screen: Control
var page = ""
var decks: Array = []
var draft: Dictionary
var dirty = false
var load_error = ""
var selected = "70"
var zone = "main"
var query = ""
var filter_kind = "全部"
var filter_color = "全部"
var library: GridContainer
var deck_rows: VBoxContainer
var preview: Control
var counts: Label
var name_label: Label
var saved_select: OptionButton
var player_choice = 0
var ai_choice = 0
var skip_check = false
var ai_one = false
var textures = {}
var battle = {}
var status = ""
var fullscreen = false
var add_amount = 1
var zone_buttons = {}
var settings_path = "res://saves/settings.json"

func _ready():
 var f = SystemFont.new()
 f.font_names = PackedStringArray(["Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans CJK SC"])
 var t = Theme.new()
 t.default_font = f
 t.default_font_size = 18
 theme = t
 var loaded = Store.load_decks()
 decks = loaded.decks
 load_error = loaded.get("error", "")
 draft = Store.blank()
 if FileAccess.file_exists(settings_path):
  var saved_settings = JSON.parse_string(FileAccess.get_file_as_string(settings_path))
  if saved_settings is Dictionary:
   fullscreen = saved_settings.get("fullscreen", false) == true
 if fullscreen: DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)
 menu()
 if not load_error.is_empty(): alert(load_error)
 if "--ui-test" in OS.get_cmdline_user_args(): call_deferred("run_ui_test")
 if "--visual-review" in OS.get_cmdline_user_args(): call_deferred("visual_review")

func _draw():
 draw_rect(Rect2(0,0,1600,900), Color("#09121d"))
 for i in range(22):
  var alpha = 0.018 + float(i) * 0.001
  draw_circle(Vector2(1150,400), 520-i*18, Color(0.13,0.28,0.35,alpha))
 for i in range(20):
  var x = float((i * 193 + 81) % 1600)
  var y = float((i * 97 + 47) % 900)
  draw_circle(Vector2(x,y), 1.4, Color(0.82,0.67,0.40,0.3))
 if page == "battle":
  if not battlefield_background.is_empty() and ResourceLoader.exists(battlefield_background):
   var tex = load(battlefield_background)
   if tex is Texture2D: draw_texture_rect(tex,Rect2(0,0,1600,900),false,Color(0.5,0.5,0.5))
  draw_colored_polygon(PackedVector2Array([Vector2(290,175),Vector2(1300,175),Vector2(1420,660),Vector2(180,660)]),Color("#142831"))
  for i in range(6):
   draw_line(Vector2(300+i*190,175),Vector2(180+i*245,660),Color(0.5,0.65,0.63,0.09),1.0)
  for y in [210,320,430,550,660]:
   draw_line(Vector2(210,y),Vector2(1400,y),Color(0.5,0.65,0.63,0.1),1)
  draw_arc(Vector2(800,424),190,0,TAU,100,Color(0.76,0.65,0.43,0.19),2,true)
  draw_arc(Vector2(800,424),164,0,TAU,100,Color(0.76,0.65,0.43,0.1),1,true)

func clear_page(next: String):
 if is_instance_valid(screen):
  remove_child(screen)
  screen.queue_free()
 screen = Control.new()
 screen.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
 add_child(screen)
 page = next
 queue_redraw()

func box(parent: Node, rect: Rect2, color: Color = INK, border: Color = Color("#30424f")) -> Panel:
 var p = Panel.new()
 p.position = rect.position
 p.size = rect.size
 p.add_theme_stylebox_override("panel", style(color,border))
 parent.add_child(p)
 return p

func style(color: Color, border: Color = Color("#3d5161")) -> StyleBoxFlat:
 var s = StyleBoxFlat.new()
 s.bg_color = color
 s.border_color = border
 s.set_border_width_all(1)
 s.set_corner_radius_all(10)
 s.content_margin_left = 14
 s.content_margin_right = 14
 s.content_margin_top = 7
 s.content_margin_bottom = 7
 return s

func label(parent: Node, text: String, rect: Rect2, font_size: int = 18, color: Color = WHITE) -> Label:
 var l = Label.new()
 l.text = text
 l.position = rect.position
 l.size = rect.size
 l.add_theme_font_size_override("font_size",font_size)
 l.add_theme_color_override("font_color",color)
 l.clip_text = true
 l.mouse_filter = Control.MOUSE_FILTER_IGNORE
 parent.add_child(l)
 return l

func button(parent: Node, text: String, rect: Rect2, action: Callable, accent: bool = false) -> Button:
 var b = Button.new()
 b.text = text
 b.position = rect.position
 b.size = rect.size
 b.add_theme_stylebox_override("normal",style(Color("#3b3325") if accent else Color("#192a38"),GOLD if accent else Color("#3d5161")))
 b.add_theme_stylebox_override("hover",style(Color("#4b4130") if accent else Color("#294354"),GOLD))
 b.add_theme_stylebox_override("pressed",style(Color("#615135"),GOLD))
 b.add_theme_stylebox_override("focus",style(Color(0,0,0,0),GOLD))
 b.add_theme_color_override("font_color",GOLD if accent else WHITE)
 b.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
 b.pressed.connect(action)
 parent.add_child(b)
 return b

func texture(id: String) -> Texture2D:
 if not Store.CARDS.has(id): return null
 if textures.has(id): return textures[id]
 var resource = load("res://recourse/demo素材/" + Store.CARDS[id].file) as Texture2D
 if resource == null: return null
 var img = resource.get_image()
 if img.get_width() > img.get_height(): img.rotate_90(CLOCKWISE)
 if img.get_width() > 700: img.resize(700,int(float(img.get_height())*700/img.get_width()),Image.INTERPOLATE_LANCZOS)
 var tex = ImageTexture.create_from_image(img)
 textures[id] = tex
 return tex

func card(parent: Node, id: String, rect: Rect2, clickable: Callable = Callable()) -> Control:
 var p = box(parent,rect,Color("#172936"),GOLD if id in ["68","70"] else Color("#416078"))
 var art = TextureRect.new()
 art.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
 art.texture = texture(id)
 art.position = Vector2(5,5)
 art.size = rect.size - Vector2(10,10)
 art.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
 art.mouse_filter = Control.MOUSE_FILTER_IGNORE
 p.add_child(art)
 if clickable.is_valid():
  p.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
  p.gui_input.connect(func(event):
   if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT: clickable.call())
 return p

func header(title: String, back: Callable):
 label(screen,"极 彩  /  MULTICOLOUR",Rect2(42,22,500,34),20,GOLD)
 label(screen,title,Rect2(42,68,1100,48),32)
 button(screen,"返回",Rect2(1430,32,126,46),back)
 box(screen,Rect2(42,126,1514,1),Color("#30424f"),Color("#30424f"))

func alert(message: String, title: String = "提示"):
 var d = AcceptDialog.new()
 d.title = title
 d.dialog_text = message
 d.min_size = Vector2i(540,180)
 d.get_ok_button().text = "知道了"
 d.confirmed.connect(d.queue_free)
 d.canceled.connect(d.queue_free)
 add_child(d)
 d.popup_centered()

func confirm_action(message: String, action: Callable):
 var d = ConfirmationDialog.new()
 d.title = "确认操作"
 d.dialog_text = message
 d.min_size = Vector2i(500,170)
 d.get_ok_button().text = "确认"
 d.get_cancel_button().text = "取消"
 d.confirmed.connect(func(): d.queue_free(); action.call())
 d.canceled.connect(d.queue_free)
 add_child(d)
 d.popup_centered()

func guard(action: Callable):
 if dirty: confirm_action("当前卡组有未保存的修改。是否放弃修改并继续？",func():
  var restored=Store.blank()
  for d in decks:
   if d.id==draft.id: restored=d.duplicate(true); break
  draft=restored
  dirty=false
  action.call())
 else: action.call()

func menu():
 clear_page("menu")
 label(screen,"MULTICOLOUR  /  CARD BATTLE",Rect2(92,74,900,42),18,GOLD)
 label(screen,"极 彩",Rect2(86,173,700,125),92)
 label(screen,"以色彩为契约，展开你的幻想之战。",Rect2(94,309,740,48),24,MUTED)
 button(screen,"人机对战    →",Rect2(96,422,440,70),setup,true)
 button(screen,"联网对战",Rect2(96,512,440,64),online)
 button(screen,"编辑牌组",Rect2(96,594,440,64),func(): editor())
 button(screen,"设置",Rect2(96,676,440,64),settings)
 label(screen,"已保存 %d 副卡组  ·  本地练习版本" % decks.size(),Rect2(96,786,700,32),16,MUTED)
 card(screen,"68",Rect2(890,205,255,360)).rotation_degrees = -12
 card(screen,"70",Rect2(1140,250,280,394)).rotation_degrees = 12
 label(screen,"DECK  /  DUEL  /  DISCOVER",Rect2(927,704,560,40),20,GOLD)
 label(screen,"从一副属于你的卡组开始",Rect2(966,747,550,42),22)
 label(screen,"基础流程演示  ·  卡面原始效果尚未结算",Rect2(1020,840,550,28),14,MUTED)

func online():
 clear_page("online")
 header("联网对战",menu)
 label(screen,"联机模式尚未开放",Rect2(410,320,900,72),38,GOLD)
 label(screen,"当前版本支持本地组卡与人机练习。",Rect2(410,412,900,60),24,MUTED)
 button(screen,"前往人机对战",Rect2(410,518,350,62),setup,true)

func settings():
 clear_page("settings")
 header("设置",menu)
 var cb = CheckButton.new()
 cb.text = "全屏显示"
 cb.position = Vector2(420,290)
 cb.size = Vector2(700,60)
 cb.button_pressed = fullscreen
 cb.toggled.connect(func(value):
  fullscreen = value
  DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN if value else DisplayServer.WINDOW_MODE_WINDOWED)
  var f = FileAccess.open(settings_path,FileAccess.WRITE)
  if f: f.store_string(JSON.stringify({"fullscreen":value}))
  else: alert("无法保存设置。"))
 screen.add_child(cb)
 label(screen,"操作说明",Rect2(420,400,600,44),28,GOLD)
 label(screen,"组卡：点击卡图预览，选择目标区域并加入卡牌。\n对战：点击手牌出牌，点击场上单位攻击，结束回合交给人机。\n本版为简化练习规则，不结算卡面中的完整技能。",Rect2(420,467,1000,145),20,MUTED)

func editor():
 clear_page("editor")
 header("卡组工坊",func(): guard(menu))
 saved_select = OptionButton.new()
 saved_select.position = Vector2(42,145)
 saved_select.size = Vector2(320,45)
 saved_select.add_item("选择已保存卡组…")
 for d in decks: saved_select.add_item(d.name)
 saved_select.item_selected.connect(func(i):
  if i > 0: guard(func(): draft=decks[i-1].duplicate(true); dirty=false; editor()))
 screen.add_child(saved_select)
 button(screen,"新建",Rect2(378,145,112,45),func(): guard(func(): draft=Store.blank(); dirty=false; editor(); rename_dialog()))
 button(screen,"重命名",Rect2(502,145,120,45),rename_dialog)
 button(screen,"复制卡组",Rect2(634,145,135,45),copy_deck)
 button(screen,"粘贴卡组",Rect2(781,145,135,45),func(): guard(paste_dialog))
 label(screen,"添加数量",Rect2(970,150,100,36),17,MUTED)
 var amount = SpinBox.new()
 amount.min_value=1
 amount.max_value=70
 amount.value=add_amount
 amount.position=Vector2(1072,145)
 amount.size=Vector2(122,45)
 amount.value_changed.connect(func(value): add_amount=int(value))
 screen.add_child(amount)
 button(screen,"保存卡组",Rect2(1380,145,176,45),save_deck,true)
 box(screen,Rect2(42,212,330,625))
 preview = Control.new()
 preview.position = Vector2(56,228)
 screen.add_child(preview)
 update_preview()
 var search = LineEdit.new()
 search.placeholder_text = "搜索卡名"
 search.text = query
 search.position = Vector2(392,212)
 search.size = Vector2(330,44)
 search.text_changed.connect(func(value): query=value; update_library())
 screen.add_child(search)
 var kind = OptionButton.new()
 kind.position = Vector2(737,212)
 kind.size = Vector2(125,44)
 for x in ["全部","自机","符卡","道具","结界"]: kind.add_item(x)
 kind.select(["全部","自机","符卡","道具","结界"].find(filter_kind))
 kind.item_selected.connect(func(i): filter_kind=kind.get_item_text(i); update_library())
 screen.add_child(kind)
 var color = OptionButton.new()
 color.position = Vector2(878,212)
 color.size = Vector2(104,44)
 for x in ["全部","红","黄","蓝"]: color.add_item(x)
 color.select(["全部","红","黄","蓝"].find(filter_color))
 color.item_selected.connect(func(i): filter_color=color.get_item_text(i); update_library())
 screen.add_child(color)
 var scroll = ScrollContainer.new()
 scroll.position = Vector2(392,273)
 scroll.size = Vector2(600,564)
 scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
 screen.add_child(scroll)
 library = GridContainer.new()
 library.columns = 3
 library.add_theme_constant_override("h_separation",14)
 library.add_theme_constant_override("v_separation",16)
 scroll.add_child(library)
 update_library()
 box(screen,Rect2(1012,212,544,625))
 name_label = label(screen,"",Rect2(1032,228,500,36),23,GOLD)
 counts = label(screen,"",Rect2(1032,274,500,32),17,MUTED)
 zone_buttons.clear()
 var choices = [["主卡组","main"],["副卡组","side"],["自机位","leader"]]
 for i in range(choices.size()):
  var z = choices[i][1]
  zone_buttons[z] = button(screen,choices[i][0],Rect2(1032+i*168,319,158,44),func(): zone=z; update_deck_rows(),zone==z)
 var ds = ScrollContainer.new()
 ds.position = Vector2(1032,378)
 ds.size = Vector2(502,376)
 ds.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
 screen.add_child(ds)
 deck_rows = VBoxContainer.new()
 deck_rows.size_flags_horizontal = Control.SIZE_EXPAND_FILL
 deck_rows.add_theme_constant_override("separation",9)
 ds.add_child(deck_rows)
 button(screen,"将当前卡牌加入所选区域",Rect2(1032,775,500,43),add_selected,true)
 update_deck_rows()
 label(screen,"保存条件：有自机  ·  容量 70 主卡组 + 10 副卡组 + 1 自机  ·  对战检查主卡组 50 张",Rect2(42,853,1480,30),16,MUTED)

func free_children(parent: Node):
 for c in parent.get_children():
  parent.remove_child(c)
  c.queue_free()

func update_preview():
 free_children(preview)
 card(preview,selected,Rect2(0,0,302,392))
 var title = label(preview,Store.CARDS[selected].name,Rect2(0,408,302,72),22,GOLD)
 title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
 label(preview,Store.CARDS[selected].kind + "  /  " + Store.CARDS[selected].color,Rect2(0,491,300,30),18,MUTED)
 button(preview,"加入主卡组",Rect2(0,536,145,45),func(): add_to("main"))
 button(preview,"设为自机",Rect2(157,536,145,45),func(): add_to("leader"),true)

func update_library():
 free_children(library)
 for id in Store.CARDS:
  var info = Store.CARDS[id]
  if not query.is_empty() and not query.to_lower() in info.name.to_lower(): continue
  if filter_kind != "全部" and info.kind != filter_kind: continue
  if filter_color != "全部" and info.color != filter_color: continue
  var tile = Control.new()
  tile.custom_minimum_size = Vector2(184,265)
  library.add_child(tile)
  card(tile,id,Rect2(0,0,184,220),func(): selected=id; update_preview())
  var short_name = info.name.replace("普通的魔法使","").replace("乐园的可爱巫女","")
  label(tile,short_name,Rect2(0,223,184,26),15)
  label(tile,info.kind + " · " + info.color,Rect2(0,247,180,22),13,MUTED)
 if library.get_child_count() == 0:
  label(library,"没有找到匹配的卡牌",Rect2(0,0,550,70),20,MUTED)

func update_deck_rows():
 for z in zone_buttons:
  zone_buttons[z].add_theme_stylebox_override("normal",style(Color("#3b3325") if z==zone else Color("#192a38"),GOLD if z==zone else Color("#3d5161")))
 name_label.text = draft.name + ("  *" if dirty else "")
 counts.text = "主卡组 %d / 70    副卡组 %d / 10    自机 %d / 1" % [draft.main.size(),draft.side.size(),0 if draft.leader.is_empty() else 1]
 free_children(deck_rows)
 var heading = Label.new()
 heading.text = {"main":"主卡组","side":"副卡组","leader":"自机位"}[zone] + "  ·  点击卡名预览"
 heading.add_theme_color_override("font_color",GOLD)
 deck_rows.add_child(heading)
 var ids = [draft.leader] if zone == "leader" and not draft.leader.is_empty() else ([] if zone == "leader" else draft[zone])
 var amounts = {}
 for id in ids: amounts[id] = amounts.get(id,0)+1
 for id in amounts:
  var row = Control.new()
  row.custom_minimum_size = Vector2(482,51)
  deck_rows.add_child(row)
  var short_name = Store.CARDS[id].name.replace("普通的魔法使","").replace("乐园的可爱巫女","")
  button(row,"%d × %s" % [amounts[id],short_name],Rect2(0,0,352,45),func(): selected=id; update_preview())
  button(row,"−",Rect2(360,0,50,45),func(): remove_card(id))
  button(row,"+",Rect2(418,0,50,45),func(): selected=id; add_selected())
 if amounts.is_empty():
  var empty = Label.new()
  empty.text = "此区域暂无卡牌\n从左侧选择卡牌，再点击加入。"
  empty.custom_minimum_size = Vector2(480,100)
  empty.add_theme_color_override("font_color",MUTED)
  deck_rows.add_child(empty)

func add_selected(): add_to(zone)
func add_to(target: String):
 var amount = 1 if target=="leader" else add_amount
 var copy = draft.duplicate(true)
 for i in range(amount):
  var error = Store.add_card(copy,selected,target)
  if not error.is_empty(): alert(error); return
 draft=copy
 zone = target
 dirty = true
 update_deck_rows()

func remove_card(id: String):
 if zone == "leader": draft.leader = ""
 else: draft[zone].erase(id)
 dirty = true
 update_deck_rows()

func rename_dialog():
 var d = ConfirmationDialog.new()
 d.title = "卡组名称"
 d.min_size = Vector2i(500,180)
 var entry = LineEdit.new()
 entry.text = draft.name
 entry.max_length = 40
 entry.position = Vector2(24,42)
 entry.size = Vector2(450,48)
 d.add_child(entry)
 d.get_ok_button().text = "确定"
 d.get_cancel_button().text = "取消"
 d.confirmed.connect(func():
  var new_name = entry.text.strip_edges()
  if new_name.is_empty(): alert("卡组名称不能为空。")
  else:
   draft.name=new_name
   dirty=true
   update_deck_rows()
  d.queue_free())
 d.canceled.connect(d.queue_free)
 add_child(d)
 d.popup_centered()
 entry.grab_focus()
 entry.select_all()

func save_deck():
 if not load_error.is_empty(): alert(load_error + "\n请先修复 saves/decks.json，避免覆盖原有数据。"); return
 var error = Store.validate(draft)
 if not error.is_empty(): alert(error,"无法保存"); return
 var next = decks.duplicate(true)
 var found = false
 for i in range(next.size()):
  if next[i].id == draft.id: next[i]=draft.duplicate(true); found=true; break
 if not found: next.append(draft.duplicate(true))
 error = Store.persist(next)
 if not error.is_empty(): alert(error,"保存失败"); return
 decks = next
 dirty = false
 editor()
 alert("「%s」已保存。\n主卡组 %d 张 · 副卡组 %d 张 · 自机 1 张" % [draft.name,draft.main.size(),draft.side.size()],"保存成功")

func copy_deck():
 var error = Store.validate(draft)
 if not error.is_empty(): alert(error,"无法复制"); return
 DisplayServer.clipboard_set(JSON.stringify(draft))
 alert("卡组代码已复制，可在「粘贴卡组」中导入为新卡组。")

func paste_dialog():
 var d = ConfirmationDialog.new()
 d.title = "粘贴卡组代码"
 d.min_size = Vector2i(690,430)
 var entry = TextEdit.new()
 entry.position=Vector2(20,40)
 entry.size=Vector2(650,310)
 entry.text=DisplayServer.clipboard_get()
 d.add_child(entry)
 d.get_ok_button().text="导入为新卡组"
 d.get_cancel_button().text="取消"
 d.confirmed.connect(func():
  var result=Store.decode(entry.text)
  if result.has("error"): alert(result.error,"导入失败")
  else: draft=result.deck; dirty=true; editor()
  d.queue_free())
 d.canceled.connect(d.queue_free)
 add_child(d)
 d.popup_centered()

func setup():
 clear_page("setup")
 header("人机对战  /  对局准备",menu)
 if decks.is_empty():
  label(screen,"先构建你的第一副卡组",Rect2(390,290,1000,75),38,GOLD)
  label(screen,"保存一副带有自机的卡组后，即可为双方选择卡组。",Rect2(390,380,1000,60),22,MUTED)
  button(screen,"前往卡组工坊",Rect2(390,495,350,64),editor,true)
  return
 player_choice=clampi(player_choice,0,decks.size()-1)
 ai_choice=clampi(ai_choice,0,decks.size()-1)
 for i in range(2):
  var x=220+i*620
  box(screen,Rect2(x,186,540,340))
  label(screen,"你的卡组" if i==0 else "人机的卡组",Rect2(x+24,205,440,40),24,GOLD)
  var pick=OptionButton.new()
  pick.position=Vector2(x+24,266)
  pick.size=Vector2(492,50)
  for d in decks: pick.add_item(d.name)
  pick.select(player_choice if i==0 else ai_choice)
  pick.item_selected.connect(func(index):
   if i==0: player_choice=index
   else: ai_choice=index
   setup())
  screen.add_child(pick)
  var chosen=decks[player_choice if i==0 else ai_choice]
  card(screen,chosen.leader,Rect2(x+24,340,106,151))
  label(screen,"主卡组 %d 张\n副卡组 %d 张\n自机已就绪" % [chosen.main.size(),chosen.side.size()],Rect2(x+160,341,340,142),22)
 var skip=CheckButton.new()
 skip.text="不检查卡组  ·  允许主卡组不是 50 张"
 skip.position=Vector2(420,568)
 skip.size=Vector2(800,45)
 skip.button_pressed=skip_check
 skip.toggled.connect(func(value): skip_check=value)
 screen.add_child(skip)
 var one=CheckButton.new()
 one.text="人机必定投 1  ·  你一定可以选择先后手"
 one.position=Vector2(420,630)
 one.size=Vector2(800,45)
 one.button_pressed=ai_one
 one.toggled.connect(func(value): ai_one=value)
 screen.add_child(one)
 button(screen,"开始对战",Rect2(570,721,460,68),start_match,true)
 label(screen,"双方可选择同一副卡组；对局使用独立副本，不会改变保存的卡组。",Rect2(370,818,1050,35),17,MUTED)

func start_match():
 for i in [player_choice,ai_choice]:
  var error=Store.validate(decks[i],not skip_check)
  if not error.is_empty():
   alert("「%s」：%s" % [decks[i].name,error],"卡组不合规")
   return
 var your_roll = randi_range(2,6) if ai_one else randi_range(1,6)
 var bot_roll = 1 if ai_one else randi_range(1,6)
 while your_roll==bot_roll: your_roll=randi_range(1,6); bot_roll=randi_range(1,6)
 if your_roll>bot_roll:
  var d=ConfirmationDialog.new()
  d.title="你赢得了投点"
  d.dialog_text="你投出 %d，人机投出 %d。请选择先后手。" % [your_roll,bot_roll]
  d.min_size=Vector2i(540,180)
  d.get_ok_button().text="我方先手"
  d.get_cancel_button().text="我方后手"
  d.confirmed.connect(func(): d.queue_free(); begin_battle(true))
  d.canceled.connect(func(): d.queue_free(); begin_battle(false))
  add_child(d)
  d.popup_centered()
 else:
  begin_battle(false)
  alert("你投出 %d，人机投出 %d。人机选择先手。" % [your_roll,bot_roll],"投点结果")

func begin_battle(first: bool):
 battle={"pdeck":decks[player_choice].main.duplicate(),"adeck":decks[ai_choice].main.duplicate(),"phand":[],"ahand":[],"pfield":[],"afield":[],"pgrave":[],"agrave":[],"php":20,"ahp":20,"round":1,"energy":3,"attacked":[],"over":false,"log":[]}
 battle.pdeck.shuffle()
 battle.adeck.shuffle()
 for i in range(5):
  draw_card("p")
  draw_card("a")
 battle.log.append("对局开始 · 我方%s手" % ("先" if first else "后"))
 if not first: ai_turn()
 battle_ui()

func draw_card(who: String):
 if not battle[who+"deck"].is_empty():
  battle[who+"hand"].append(battle[who+"deck"].pop_back())

func battle_ui():
 clear_page("battle")
 label(screen,"极 彩   /   练习竞技场",Rect2(30,20,650,42),22,GOLD)
 button(screen,"投降",Rect2(1440,21,130,46),func(): confirm_action("确定投降并返回对局准备页面？",func(): battle.clear(); setup()))
 label(screen,"回合 %d  ·  你的行动  ·  能量 %d / 3" % [battle.round,battle.energy],Rect2(550,30,790,40),22)
 label(screen,"人机   %s   ·   生命 %d" % [decks[ai_choice].name,battle.ahp],Rect2(580,110,800,48),25)
 label(screen,"你   %s   ·   生命 %d" % [decks[player_choice].name,battle.php],Rect2(560,635,800,44),25,GOLD)
 label(screen,"对方自机",Rect2(36,143,150,30),17,MUTED)
 card(screen,decks[ai_choice].leader,Rect2(34,181,132,182))
 label(screen,"我方自机",Rect2(36,437,150,30),17,GOLD)
 card(screen,decks[player_choice].leader,Rect2(34,475,132,182))
 button(screen,"墓地  %d / %d" % [battle.pgrave.size(),battle.agrave.size()],Rect2(1390,150,180,86),graveyard)
 box(screen,Rect2(1410,380,138,176),Color("#152638"),GOLD)
 label(screen,"极 彩\n牌 库\n%d 张" % battle.pdeck.size(),Rect2(1427,406,106,134),25,GOLD)
 label(screen,"人机牌库 %d\n人机手牌 %d" % [battle.adeck.size(),battle.ahand.size()],Rect2(1385,257,195,78),17,MUTED)
 for i in range(battle.afield.size()):
  card(screen,battle.afield[i],Rect2(320+i*155,201,127,166),func(): show_card_info(battle.afield[i]))
 for i in range(battle.pfield.size()):
  var id=battle.pfield[i]
  var p=card(screen,id,Rect2(320+i*155,454,127,166),func(): attack(i))
  if i in battle.attacked: p.modulate=Color(0.55,0.6,0.65)
 label(screen,"敌方战场",Rect2(694,375,300,35),19,MUTED)
 label(screen,"我方战场  ·  点击单位攻击",Rect2(619,408,600,35),19,GOLD)
 var hand_scroll=ScrollContainer.new()
 hand_scroll.position=Vector2(230,700)
 hand_scroll.size=Vector2(1136,182)
 hand_scroll.vertical_scroll_mode=ScrollContainer.SCROLL_MODE_DISABLED
 screen.add_child(hand_scroll)
 var hand_row=HBoxContainer.new()
 hand_row.add_theme_constant_override("separation",12)
 hand_scroll.add_child(hand_row)
 for i in range(battle.phand.size()):
  var tile=Control.new()
  tile.custom_minimum_size=Vector2(114,164)
  hand_row.add_child(tile)
  card(tile,battle.phand[i],Rect2(0,0,114,158),func(): play_card(i))
 button(screen,"结束回合",Rect2(1380,738,195,68),end_turn,true)
 var recent="\n".join(battle.log.slice(maxi(0,battle.log.size()-3)))
 label(screen,recent,Rect2(26,711,200,123),13,MUTED).autowrap_mode=TextServer.AUTOWRAP_WORD_SMART
 label(screen,"简化练习：出牌消耗 1 能量；单位与符卡造成 2 点；道具回复 1 生命。卡面技能暂未实现。",Rect2(249,880,1290,20),12,MUTED)

func show_card_info(id: String):
 var d=AcceptDialog.new()
 d.title=Store.CARDS[id].name
 d.min_size=Vector2i(500,640)
 card(d,id,Rect2(55,24,380,530))
 d.confirmed.connect(d.queue_free)
 d.canceled.connect(d.queue_free)
 add_child(d)
 d.popup_centered()

func play_card(index: int):
 if battle.over or index>=battle.phand.size(): return
 if battle.energy<=0: alert("本回合能量已用尽，请结束回合。"); return
 var id=battle.phand[index]
 var kind=Store.CARDS[id].kind
 if kind in ["单位","自机","结界"] and battle.pfield.size()>=6: alert("战场最多容纳 6 张牌。"); return
 battle.phand.remove_at(index)
 battle.energy-=1
 if kind=="符卡":
  battle.ahp-=2
  battle.pgrave.append(id)
 elif kind=="道具":
  battle.php=mini(20,battle.php+1)
  battle.pgrave.append(id)
 else: battle.pfield.append(id)
 battle.log.append("我方打出 " + Store.CARDS[id].name)
 if battle.ahp<=0: finish_match("胜利","人机生命归零。"); return
 battle_ui()

func attack(index: int):
 if index in battle.attacked: alert("该单位本回合已行动。"); return
 if Store.CARDS[battle.pfield[index]].kind=="结界": alert("结界不能攻击。"); return
 battle.attacked.append(index)
 if not battle.afield.is_empty():
  battle.agrave.append(battle.afield.pop_front())
  battle.log.append("我方击破一张敌方场上牌")
 else:
  battle.ahp-=2
  battle.log.append("人机受到 2 点伤害")
 if battle.ahp<=0: finish_match("胜利","人机生命归零。"); return
 battle_ui()

func ai_turn():
 draw_card("a")
 if not battle.ahand.is_empty():
  var id=battle.ahand.pop_front()
  if Store.CARDS[id].kind=="符卡":
   battle.php-=2
   battle.agrave.append(id)
  elif Store.CARDS[id].kind=="道具":
   battle.ahp=mini(20,battle.ahp+1)
   battle.agrave.append(id)
  elif battle.afield.size()<6: battle.afield.append(id)
  else: battle.ahand.append(id)
  battle.log.append("人机完成出牌")
 for id in battle.afield:
  if Store.CARDS[id].kind=="结界": continue
  if not battle.pfield.is_empty(): battle.pgrave.append(battle.pfield.pop_front())
  else: battle.php-=2

func end_turn():
 ai_turn()
 if battle.php<=0: finish_match("对局结束","你的生命归零，人机获胜。"); return
 battle.round+=1
 battle.energy=3
 battle.attacked.clear()
 draw_card("p")
 battle.log.append("第 %d 回合开始" % battle.round)
 battle_ui()

func finish_match(title: String, reason: String):
 battle.over=true
 var d=AcceptDialog.new()
 d.title=title
 d.dialog_text=reason
 d.min_size=Vector2i(480,180)
 d.get_ok_button().text="返回对局准备"
 d.confirmed.connect(func(): d.queue_free(); battle.clear(); setup())
 d.canceled.connect(func(): d.queue_free(); battle.clear(); setup())
 add_child(d)
 d.popup_centered()

func graveyard():
 var names="我方墓地：\n"
 for id in battle.pgrave: names+=Store.CARDS[id].name+"\n"
 names+="\n人机墓地：\n"
 for id in battle.agrave: names+=Store.CARDS[id].name+"\n"
 var d=AcceptDialog.new()
 d.title="墓地"
 d.min_size=Vector2i(640,520)
 var text=TextEdit.new()
 text.position=Vector2(20,35)
 text.size=Vector2(600,420)
 text.editable=false
 text.text=names
 d.add_child(text)
 d.confirmed.connect(d.queue_free)
 d.canceled.connect(d.queue_free)
 add_child(d)
 d.popup_centered()

func run_ui_test():
 var original_decks=decks.duplicate(true)
 var sample=Store.blank("自动测试")
 sample.leader="70"
 for i in range(50): sample.main.append("68")
 decks=[sample]
 draft=sample.duplicate(true)
 editor()
 selected="164"
 add_to("side")
 assert(draft.side.size()==1)
 zone="side"
 remove_card("164")
 assert(draft.side.is_empty())
 setup()
 begin_battle(true)
 assert(battle.phand.size()==5 and battle.pdeck.size()==45)
 play_card(0)
 assert(battle.pfield.size()==1 and battle.energy==2)
 attack(0)
 assert(battle.ahp==18)
 end_turn()
 assert(battle.round==2)
 battle.clear()
 setup()
 assert(page=="setup")
 decks=original_decks
 draft=Store.blank()
 dirty=false
 menu()
 var report=FileAccess.open("res://work/ui-test.txt",FileAccess.WRITE)
 report.store_string("PASS: editor add/remove; setup; draw 5; play; attack; AI turn; surrender destination; menu restoration.")
 print("UI_TEST_PASS")
 get_tree().quit()

func visual_review():
 var a=Store.blank("博丽神社")
 a.leader="70"
 for i in range(25): a.main.append("70"); a.main.append("165")
 var b=Store.blank("魔法森林")
 b.leader="68"
 for i in range(25): b.main.append("68"); b.main.append("99")
 decks=[a,b]
 player_choice=0
 ai_choice=1
 draft=a.duplicate(true)
 menu()
 await capture_review("menu")
 editor()
 await capture_review("editor")
 setup()
 await capture_review("setup")
 begin_battle(true)
 play_card(0)
