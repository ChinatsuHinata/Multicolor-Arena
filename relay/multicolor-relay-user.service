[Unit]
Description=Multicolor Arena room relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/multicolor-relay
ExecStart=%h/.local/bin/godot --headless --path %h/.local/share/multicolor-relay --script server.gd -- --port 47862
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
